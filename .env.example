# CrewPay environment template. Placeholders only: never put real values here.
# Copy to .env.local (git-ignored) and fill in values locally.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time. Secrets must NEVER use the NEXT_PUBLIC_ prefix.
# Schemas: src/lib/env/client.ts (public) and src/lib/env/server.ts (secrets).

# --- Public (browser-exposed) -------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key is public by design; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only (secrets) ----------------------------------------------------
# Bypasses Row Level Security. Not used by any request path yet; needed only
# for `npm run test:integration`. Use a disposable/test project.
SUPABASE_SECRET_KEY=

# Blaaiz OAuth (server-only, never NEXT_PUBLIC_). Leave the five OAuth values
# empty until credentials are issued, or set all five. Only the documented hosts
# are accepted, and the token URL must be <base URL>/oauth/token. Development:
#   BLAAIZ_BASE_URL=https://api-dev.blaaiz.com
#   BLAAIZ_TOKEN_URL=https://api-dev.blaaiz.com/oauth/token
# BLAAIZ_SCOPES: the space-separated individual scopes assigned to the
# credential (e.g. `wallet:read currency:read`), never bundle names such as
# `full-access`. Verify with: CREWPAY_RUN_BLAAIZ=1 npm run test:integration -- tests/integration/blaaiz.test.ts
BLAAIZ_CLIENT_ID=
BLAAIZ_CLIENT_SECRET=
BLAAIZ_BASE_URL=
BLAAIZ_TOKEN_URL=
BLAAIZ_SCOPES=
# Optional until webhooks are built.
BLAAIZ_WEBHOOK_SIGNING_SECRET=
